<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_IGPULSE</name>
    <author>hirleicarlos</author>
    <authorUrl>https://github.com/hirleicarlos/mod_igpulse</authorUrl>
    <creationDate>2026-05-09</creationDate>
    <version>1.0.0</version>
    <description>MOD_IGPULSE_XML_DESCRIPTION</description>

    <files>
        <filename module="mod_igpulse">mod_igpulse.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>

    <media destination="mod_igpulse" folder="media">
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <languages>
        <language tag="en-GB">language/en-GB/mod_igpulse.ini</language>
        <language tag="pt-BR">language/pt-BR/mod_igpulse.ini</language>
    </languages>

    <config>
        <fields name="params">

            <!-- Authentication -->
            <fieldset name="authentication" label="MOD_IGPULSE_FIELDSET_AUTH">
                <field
                    name="access_token"
                    type="text"
                    label="MOD_IGPULSE_FIELD_ACCESS_TOKEN_LABEL"
                    description="MOD_IGPULSE_FIELD_ACCESS_TOKEN_DESC"
                    size="80"
                    required="true"
                    filter="string"
                />
                <field
                    name="user_id"
                    type="text"
                    label="MOD_IGPULSE_FIELD_USER_ID_LABEL"
                    description="MOD_IGPULSE_FIELD_USER_ID_DESC"
                    size="40"
                    required="true"
                    filter="string"
                />
            </fieldset>

            <!-- Content -->
            <fieldset name="content" label="MOD_IGPULSE_FIELDSET_CONTENT">
                <field
                    name="media_type"
                    type="list"
                    label="MOD_IGPULSE_FIELD_MEDIA_TYPE_LABEL"
                    description="MOD_IGPULSE_FIELD_MEDIA_TYPE_DESC"
                    default="ALL">
                    <option value="ALL">MOD_IGPULSE_MEDIA_ALL</option>
                    <option value="IMAGE">MOD_IGPULSE_MEDIA_POSTS</option>
                    <option value="VIDEO">MOD_IGPULSE_MEDIA_REELS</option>
                </field>
                <field
                    name="count_fetch"
                    type="number"
                    label="MOD_IGPULSE_FIELD_COUNT_FETCH_LABEL"
                    description="MOD_IGPULSE_FIELD_COUNT_FETCH_DESC"
                    default="12"
                    min="1"
                    max="20"
                    step="1"
                    filter="integer"
                />
                <field
                    name="count_desktop"
                    type="number"
                    label="MOD_IGPULSE_FIELD_COUNT_DESKTOP_LABEL"
                    description="MOD_IGPULSE_FIELD_COUNT_DESKTOP_DESC"
                    default="6"
                    min="1"
                    max="20"
                    step="1"
                    filter="integer"
                />
                <field
                    name="count_mobile"
                    type="number"
                    label="MOD_IGPULSE_FIELD_COUNT_MOBILE_LABEL"
                    description="MOD_IGPULSE_FIELD_COUNT_MOBILE_DESC"
                    default="2"
                    min="1"
                    max="6"
                    step="1"
                    filter="integer"
                />
            </fieldset>

            <!-- Layout -->
            <fieldset name="layout_settings" label="MOD_IGPULSE_FIELDSET_LAYOUT">
                <field
                    name="layout_style"
                    type="list"
                    label="MOD_IGPULSE_FIELD_LAYOUT_STYLE_LABEL"
                    description="MOD_IGPULSE_FIELD_LAYOUT_STYLE_DESC"
                    default="carousel">
                    <option value="carousel">MOD_IGPULSE_LAYOUT_CAROUSEL</option>
                    <option value="grid">MOD_IGPULSE_LAYOUT_GRID</option>
                    <option value="mosaic">MOD_IGPULSE_LAYOUT_MOSAIC</option>
                    <option value="strip">MOD_IGPULSE_LAYOUT_STRIP</option>
                </field>
                <field
                    name="columns_desktop"
                    type="list"
                    label="MOD_IGPULSE_FIELD_COLUMNS_DESKTOP_LABEL"
                    description="MOD_IGPULSE_FIELD_COLUMNS_DESKTOP_DESC"
                    default="3">
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </field>
                <field
                    name="columns_mobile"
                    type="list"
                    label="MOD_IGPULSE_FIELD_COLUMNS_MOBILE_LABEL"
                    description="MOD_IGPULSE_FIELD_COLUMNS_MOBILE_DESC"
                    default="1">
                    <option value="1">1</option>
                    <option value="2">2</option>
                </field>
                <field
                    name="show_caption"
                    type="radio"
                    label="MOD_IGPULSE_FIELD_SHOW_CAPTION_LABEL"
                    description="MOD_IGPULSE_FIELD_SHOW_CAPTION_DESC"
                    default="0"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="show_likes"
                    type="radio"
                    label="MOD_IGPULSE_FIELD_SHOW_LIKES_LABEL"
                    description="MOD_IGPULSE_FIELD_SHOW_LIKES_DESC"
                    default="0"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="open_in"
                    type="list"
                    label="MOD_IGPULSE_FIELD_OPEN_IN_LABEL"
                    description="MOD_IGPULSE_FIELD_OPEN_IN_DESC"
                    default="instagram">
                    <option value="lightbox">MOD_IGPULSE_OPEN_LIGHTBOX</option>
                    <option value="newtab">MOD_IGPULSE_OPEN_NEWTAB</option>
                    <option value="instagram">MOD_IGPULSE_OPEN_INSTAGRAM</option>
                </field>
            </fieldset>

            <!-- Cache -->
            <fieldset name="cache_settings" label="MOD_IGPULSE_FIELDSET_CACHE">
                <field
                    name="cache_time"
                    type="number"
                    label="MOD_IGPULSE_FIELD_CACHE_TIME_LABEL"
                    description="MOD_IGPULSE_FIELD_CACHE_TIME_DESC"
                    default="60"
                    min="5"
                    max="1440"
                    step="5"
                    filter="integer"
                />
            </fieldset>

        </fields>
    </config>
</extension>
